{
  "name": "the-logic-broker",
  "private": true,
  "version": "0.1.0",
  "description": "The Logic Broker — luxury AI-automation agency platform (monorepo root).",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter=./apps/* run dev",
    "dev:web": "pnpm --filter @tlb/web dev",
    "dev:api": "pnpm --filter @tlb/api dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "db:generate": "pnpm --filter @tlb/db run generate",
    "db:migrate": "pnpm --filter @tlb/db run migrate",
    "db:push": "pnpm --filter @tlb/db run push",
    "db:studio": "pnpm --filter @tlb/db run studio",
    "clean": "pnpm -r exec rimraf dist .next .turbo node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
