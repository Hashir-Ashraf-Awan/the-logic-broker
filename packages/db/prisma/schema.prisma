// The Logic Broker — Prisma schema
// Source of truth for both apps/web and apps/api via @tlb/db.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Identity
// ────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  EDITOR
  CLIENT
  GUEST
}

model User {
  id            String   @id @default(cuid())
  clerkId       String?  @unique
  email         String   @unique
  name          String?
  avatarUrl     String?
  role          Role     @default(GUEST)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastLoginAt   DateTime?

  authoredPosts Post[]            @relation("PostAuthor")
  projects      Project[]         @relation("ProjectOwner")
  messages      ProjectMessage[]
  files         ProjectFile[]
  bookings      Booking[]
  invoices      Invoice[]

  @@index([role])
}

// ────────────────────────────────────────────────────────────────────────────
// Marketing CMS
// ────────────────────────────────────────────────────────────────────────────

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String
  body        String     // markdown / MDX
  coverImage  String?
  readingTime Int        @default(5) // minutes
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  seoTitle    String?
  seoDesc     String?

  authorId    String
  author      User       @relation("PostAuthor", fields: [authorId], references: [id])

  tags        Tag[]      @relation("PostTags")

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
}

model Tag {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  posts Post[] @relation("PostTags")
}

model Testimonial {
  id          String   @id @default(cuid())
  authorName  String
  authorTitle String?
  company     String?
  avatarUrl   String?
  quote       String
  rating      Int      @default(5)
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([featured, published])
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  tagline     String
  description String
  icon        String   // lucide icon name
  features    String[] // bullet points
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}

model CaseStudy {
  id          String   @id @default(cuid())
  slug        String   @unique
  client      String
  industry    String
  title       String
  summary     String
  body        String
  heroImage   String?
  metrics     Json     // [{ label: string, value: string }]
  tech        String[]
  published   Boolean  @default(true)
  featured    Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, featured])
}

// ────────────────────────────────────────────────────────────────────────────
// Lead capture
// ────────────────────────────────────────────────────────────────────────────

enum ContactStatus {
  NEW
  IN_PROGRESS
  WON
  LOST
  SPAM
}

model ContactSubmission {
  id        String        @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  budget    String?
  message   String
  source    String?       // utm_source or page
  status    ContactStatus @default(NEW)
  ipHash    String?
  userAgent String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model NewsletterSubscriber {
  id            String   @id @default(cuid())
  email         String   @unique
  source        String?
  confirmed     Boolean  @default(false)
  confirmToken  String?  @unique
  unsubToken    String   @unique @default(cuid())
  subscribedAt  DateTime @default(now())
  unsubscribedAt DateTime?

  @@index([confirmed])
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Booking {
  id          String        @id @default(cuid())
  name        String
  email       String
  company     String?
  topic       String
  message     String?
  scheduledAt DateTime
  duration    Int           @default(30) // minutes
  status      BookingStatus @default(REQUESTED)
  meetingUrl  String?

  userId      String?
  user        User?         @relation(fields: [userId], references: [id])

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, scheduledAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Client portal
// ────────────────────────────────────────────────────────────────────────────

enum ProjectStatus {
  DISCOVERY
  IN_PROGRESS
  REVIEW
  COMPLETED
  PAUSED
}

model Project {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  status      ProjectStatus @default(DISCOVERY)
  progress    Int           @default(0) // 0-100
  startDate   DateTime?
  dueDate     DateTime?

  ownerId     String
  owner       User          @relation("ProjectOwner", fields: [ownerId], references: [id])

  milestones  Milestone[]
  files       ProjectFile[]
  messages    ProjectMessage[]
  invoices    Invoice[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([ownerId])
}

model Milestone {
  id        String   @id @default(cuid())
  title     String
  body      String?
  dueDate   DateTime?
  done      Boolean  @default(false)

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, done])
}

model ProjectFile {
  id         String   @id @default(cuid())
  name       String
  url        String
  mime       String
  size       Int
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  createdAt  DateTime @default(now())

  @@index([projectId])
}

model ProjectMessage {
  id        String   @id @default(cuid())
  body      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id        String        @id @default(cuid())
  number    String        @unique
  amount    Int           // cents
  currency  String        @default("USD")
  status    InvoiceStatus @default(DRAFT)
  issuedAt  DateTime      @default(now())
  dueAt     DateTime?
  paidAt    DateTime?
  pdfUrl    String?

  projectId String?
  project   Project?      @relation(fields: [projectId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([userId])
}

// ────────────────────────────────────────────────────────────────────────────
// Admin / ops
// ────────────────────────────────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action])
}
